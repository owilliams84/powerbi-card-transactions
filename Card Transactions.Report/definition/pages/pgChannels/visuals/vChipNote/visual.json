        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "That is not an EMV migration",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#0A0917",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "4pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Chip does not phase in here. It is 0.0% of transactions in December 2014, 68% in January 2015, and then flat within a point of that for the next five years.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "4pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The real US liability shift was October 2015 and took years to work through the estate. A switch that clean is a property of how this file was generated, not of anything a bank did.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "4pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The data is internally consistent - every chip transaction comes from a card the file marks as chip-enabled - so the flag is not random. It is just not a timeline.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "4pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Which is why this page reports the channel mix and stops short of calling it adoption.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
