# Power BI Desktop writes these next to the PBIP while a project is open. They are per-machine
# state (window layout, cached model data, credentials), not part of the definition.
.pbi/
**/.pbi/
localSettings.json
**/localSettings.json
*.pbix
cache.abf
diagramLayout.json

# Working captures from the screenshot loop; only the three cropped pages are committed.
screenshots/raw_*.png
screenshots/_*.png

# Python
__pycache__/
*.py[cod]

# OS
Thumbs.db
desktop.ini
.DS_Store

# The DAX-vs-pandas comparison output; regenerated by query_model.ps1 against a live model.
etl/checks/dax_actual.csv

# The naive model's flat table: ~300 MB, regenerated by perf/etl/build_flat_source.py
# from the Kaggle source. The star schema's CSVs in data/ are committed; this one is not.
perf/data/*.csv

# The raw DMV dumps and timings in perf/measurements ARE committed: they are the evidence
# behind the comparison, they are small, and with them a reader can re-run compare.py
# without a Power BI install.
