/// Measures behind the Calendar page: SVG cells, shade bands, cards, titles. Generated by
/// etl/milestone_calendar.py from the CALENDAR config.
table 'Calendar Metrics'
	lineageTag: 9f288e88-da64-5fec-9534-7e5e03d785e8

	/// 1 (lowest fifth of the cells on screen) to 5 (highest); 0 for an empty cell; blank
	/// where the grid has no such cell. Rank-based so one outlier cannot flatten the rest.
	measure 'Cal Band Day' =
			VAR Me = [Spend]
			VAR Live = FILTER(CALCULATETABLE(ADDCOLUMNS(VALUES('Date'[Date]), "@v", [Spend]), ALLSELECTED('Date')), [@v] > 0)
			VAR N = COUNTROWS(Live)
			VAR Below = COUNTROWS(FILTER(Live, [@v] < Me))
			RETURN
			    IF(
			        HASONEVALUE('Date'[Date]),
			        IF(Me > 0, IF(N <= 1, 5, MIN(5, INT(DIVIDE((Below + 0) * 5, N - 1)) + 1)), 0)
			    )
		formatString: 0
		lineageTag: 9f52cc51-7c6f-5762-9f33-510b6df7ed02

	/// Cell background for the band. Bound to the matrix's background colour.
	measure 'Cal Colour Day' =
			VAR Band = [Cal Band Day]
			RETURN
			    IF(NOT ISBLANK(Band), SWITCH(Band, 1, "#E6E9F1", 2, "#BCC1D2", 3, "#7C8598", 4, "#3E4A66", 5, "#111F38", "#F4F6FA"))
		lineageTag: bebd2efa-10d2-53a7-af2c-d01ee37efaa5

	/// One calendar cell at the Day grain, drawn at 112x88.
	measure 'Cal Cell Day' =
			VAR Band = [Cal Band Day]
			VAR V = [Spend]
			VAR Cnt = [Approved Transactions]
			VAR Fg = SWITCH(TRUE(), Band = 0, "#667284", Band >= 3, "#FFFFFF", "#0A0917")
			VAR Bg = [Cal Colour Day]
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='112' height='88' viewBox='0 0 112 88' font-family='Segoe UI, sans-serif'>"
			        & "<rect width='112' height='88' fill='" & Bg & "'/>"
			        & "<text x='8' y='17' font-size='11.5' font-weight='600' fill='" & Fg & "' opacity='0.85'>" & FORMAT(DAY(SELECTEDVALUE('Date'[Date])), "00") & "</text>"
			        & IF(
			            Band = 0,
			            "<text x='56' y='49' font-size='13' text-anchor='middle' fill='#667284'>&#8211;</text>",
			            "<text x='56' y='50' font-size='17' font-weight='700' text-anchor='middle' fill='" & Fg & "'>" & SWITCH(TRUE(), V >= 1000000, "$" & FORMAT(V / 1000000, "0.00") & "M", V >= 10000, "$" & FORMAT(V / 1000, "0.0") & "k", V >= 1000, "$" & FORMAT(V / 1000, "0.00") & "k", "$" & FORMAT(V, "0")) & "</text>"
			                & "<text x='104' y='80' font-size='10.5' text-anchor='end' fill='" & Fg & "' opacity='0.8'>" & FORMAT(Cnt, "#,0") & IF(Cnt = 1, " transaction", " transactions") & "</text>"
			        )
			        & "</svg>"
			RETURN
			    IF(NOT ISBLANK(Band), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		dataCategory: ImageUrl
		lineageTag: 0620f290-8b3a-5212-ad37-1c7f8afa4123

	/// 1 (lowest fifth of the cells on screen) to 5 (highest); 0 for an empty cell; blank
	/// where the grid has no such cell. Rank-based so one outlier cannot flatten the rest.
	measure 'Cal Band Month' =
			VAR Me = [Spend]
			VAR Live = FILTER(CALCULATETABLE(ADDCOLUMNS(VALUES('Date'[Cal Month No]), "@v", [Spend]), ALLSELECTED('Date')), [@v] > 0)
			VAR N = COUNTROWS(Live)
			VAR Below = COUNTROWS(FILTER(Live, [@v] < Me))
			RETURN
			    IF(
			        HASONEVALUE('Date'[Cal Month No]),
			        IF(Me > 0, IF(N <= 1, 5, MIN(5, INT(DIVIDE((Below + 0) * 5, N - 1)) + 1)), 0)
			    )
		formatString: 0
		lineageTag: 901d32b6-8b31-5d57-a985-10246d96187d

	/// Cell background for the band. Bound to the matrix's background colour.
	measure 'Cal Colour Month' =
			VAR Band = [Cal Band Month]
			RETURN
			    IF(NOT ISBLANK(Band), SWITCH(Band, 1, "#E6E9F1", 2, "#BCC1D2", 3, "#7C8598", 4, "#3E4A66", 5, "#111F38", "#F4F6FA"))
		lineageTag: d95ddee7-60e3-5b88-8726-030c906039ad

	/// One calendar cell at the Month grain, drawn at 266x138.
	measure 'Cal Cell Month' =
			VAR Band = [Cal Band Month]
			VAR V = [Spend]
			VAR Cnt = [Approved Transactions]
			VAR Fg = SWITCH(TRUE(), Band = 0, "#667284", Band >= 3, "#FFFFFF", "#0A0917")
			VAR Bg = [Cal Colour Month]
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='266' height='138' viewBox='0 0 266 138' font-family='Segoe UI, sans-serif'>"
			        & "<rect width='266' height='138' fill='" & Bg & "'/>"
			        & "<text x='8' y='17' font-size='11.5' font-weight='600' fill='" & Fg & "' opacity='0.85'>" & SELECTEDVALUE('Date'[Cal Month Short]) & "</text>"
			        & IF(
			            Band = 0,
			            "<text x='133' y='74' font-size='13' text-anchor='middle' fill='#667284'>&#8211;</text>",
			            "<text x='133' y='75' font-size='17' font-weight='700' text-anchor='middle' fill='" & Fg & "'>" & SWITCH(TRUE(), V >= 1000000, "$" & FORMAT(V / 1000000, "0.00") & "M", V >= 10000, "$" & FORMAT(V / 1000, "0.0") & "k", V >= 1000, "$" & FORMAT(V / 1000, "0.00") & "k", "$" & FORMAT(V, "0")) & "</text>"
			                & "<text x='258' y='130' font-size='10.5' text-anchor='end' fill='" & Fg & "' opacity='0.8'>" & FORMAT(Cnt, "#,0") & IF(Cnt = 1, " transaction", " transactions") & "</text>"
			        )
			        & "</svg>"
			RETURN
			    IF(NOT ISBLANK(Band), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		dataCategory: ImageUrl
		lineageTag: 0cb50599-8ef2-59cb-91cc-bcef97d1fdbb

	/// 1 (lowest fifth of the cells on screen) to 5 (highest); 0 for an empty cell; blank
	/// where the grid has no such cell. Rank-based so one outlier cannot flatten the rest.
	measure 'Cal Band Quarter' =
			VAR Me = [Spend]
			VAR Live = FILTER(CALCULATETABLE(ADDCOLUMNS(VALUES('Date'[Cal Quarter Key]), "@v", [Spend]), ALLSELECTED('Date')), [@v] > 0)
			VAR N = COUNTROWS(Live)
			VAR Below = COUNTROWS(FILTER(Live, [@v] < Me))
			RETURN
			    IF(
			        HASONEVALUE('Date'[Cal Quarter Key]),
			        IF(Me > 0, IF(N <= 1, 5, MIN(5, INT(DIVIDE((Below + 0) * 5, N - 1)) + 1)), 0)
			    )
		formatString: 0
		lineageTag: 3afb5d10-5da7-5497-a4a6-4552396c8032

	/// Cell background for the band. Bound to the matrix's background colour.
	measure 'Cal Colour Quarter' =
			VAR Band = [Cal Band Quarter]
			RETURN
			    IF(NOT ISBLANK(Band), SWITCH(Band, 1, "#E6E9F1", 2, "#BCC1D2", 3, "#7C8598", 4, "#3E4A66", 5, "#111F38", "#F4F6FA"))
		lineageTag: 367d98b0-ac0d-5fa4-9f81-ab63b7c8d340

	/// One calendar cell at the Quarter grain, drawn at 196x56.
	measure 'Cal Cell Quarter' =
			VAR Band = [Cal Band Quarter]
			VAR V = [Spend]
			VAR Cnt = [Approved Transactions]
			VAR Fg = SWITCH(TRUE(), Band = 0, "#667284", Band >= 3, "#FFFFFF", "#0A0917")
			VAR Bg = [Cal Colour Quarter]
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='196' height='56' viewBox='0 0 196 56' font-family='Segoe UI, sans-serif'>"
			        & "<rect width='196' height='56' fill='" & Bg & "'/>"
			        & "<text x='8' y='17' font-size='11.5' font-weight='600' fill='" & Fg & "' opacity='0.85'>" & SELECTEDVALUE('Date'[Cal Quarter Label]) & "</text>"
			        & IF(
			            Band = 0,
			            "<text x='98' y='33' font-size='13' text-anchor='middle' fill='#667284'>&#8211;</text>",
			            "<text x='98' y='34' font-size='14' font-weight='700' text-anchor='middle' fill='" & Fg & "'>" & SWITCH(TRUE(), V >= 1000000, "$" & FORMAT(V / 1000000, "0.00") & "M", V >= 10000, "$" & FORMAT(V / 1000, "0.0") & "k", V >= 1000, "$" & FORMAT(V / 1000, "0.00") & "k", "$" & FORMAT(V, "0")) & "</text>"
			                & "<text x='188' y='48' font-size='10.5' text-anchor='end' fill='" & Fg & "' opacity='0.8'>" & FORMAT(Cnt, "#,0") & IF(Cnt = 1, " transaction", " transactions") & "</text>"
			        )
			        & "</svg>"
			RETURN
			    IF(NOT ISBLANK(Band), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		dataCategory: ImageUrl
		lineageTag: ce777fae-cc6c-55b8-8ff1-718fb178d7be

	/// 1 (lowest fifth of the cells on screen) to 5 (highest); 0 for an empty cell; blank
	/// where the grid has no such cell. Rank-based so one outlier cannot flatten the rest.
	measure 'Cal Band Year' =
			VAR Me = [Spend]
			VAR Live = FILTER(CALCULATETABLE(ADDCOLUMNS(VALUES('Date'[Cal Year]), "@v", [Spend]), ALLSELECTED('Date')), [@v] > 0)
			VAR N = COUNTROWS(Live)
			VAR Below = COUNTROWS(FILTER(Live, [@v] < Me))
			RETURN
			    IF(
			        HASONEVALUE('Date'[Cal Year]),
			        IF(Me > 0, IF(N <= 1, 5, MIN(5, INT(DIVIDE((Below + 0) * 5, N - 1)) + 1)), 0)
			    )
		formatString: 0
		lineageTag: 33a08160-b258-5b30-aef2-151f554d4d33

	/// Cell background for the band. Bound to the matrix's background colour.
	measure 'Cal Colour Year' =
			VAR Band = [Cal Band Year]
			RETURN
			    IF(NOT ISBLANK(Band), SWITCH(Band, 1, "#E6E9F1", 2, "#BCC1D2", 3, "#7C8598", 4, "#3E4A66", 5, "#111F38", "#F4F6FA"))
		lineageTag: 91e95f46-4bfc-5839-9511-7399ef10a873

	/// One calendar cell at the Year grain, drawn at 74x230.
	measure 'Cal Cell Year' =
			VAR Band = [Cal Band Year]
			VAR V = [Spend]
			VAR Cnt = [Approved Transactions]
			VAR Fg = SWITCH(TRUE(), Band = 0, "#667284", Band >= 3, "#FFFFFF", "#0A0917")
			VAR Bg = [Cal Colour Year]
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='74' height='230' viewBox='0 0 74 230' font-family='Segoe UI, sans-serif'>"
			        & "<rect width='74' height='230' fill='" & Bg & "'/>"
			        & "<text x='8' y='17' font-size='11.5' font-weight='600' fill='" & Fg & "' opacity='0.85'>" & FORMAT(SELECTEDVALUE('Date'[Cal Year]), "0") & "</text>"
			        & IF(
			            Band = 0,
			            "<text x='37' y='120' font-size='13' text-anchor='middle' fill='#667284'>&#8211;</text>",
			            "<text x='37' y='121' font-size='14' font-weight='700' text-anchor='middle' fill='" & Fg & "'>" & SWITCH(TRUE(), V >= 1000000, "$" & FORMAT(V / 1000000, "0.00") & "M", V >= 10000, "$" & FORMAT(V / 1000, "0.0") & "k", V >= 1000, "$" & FORMAT(V / 1000, "0.00") & "k", "$" & FORMAT(V, "0")) & "</text>"
			        )
			        & "</svg>"
			RETURN
			    IF(NOT ISBLANK(Band), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		dataCategory: ImageUrl
		lineageTag: 1c03b1f6-acf7-5e8d-b2fd-c66d699dc1dc

	/// Days on which spend is above zero.
	measure 'Cal Active Days' = COUNTROWS(FILTER(VALUES('Date'[Date]), [Spend] > 0))
		formatString: #,0
		lineageTag: c9b9170e-6122-5bce-9977-27aa0bc83d3c

	/// Spend divided by the days that had any.
	measure 'Cal Avg per Active Day' = DIVIDE([Spend], [Cal Active Days])
		formatString: \$#,0
		lineageTag: 3f4ac3d7-4a19-5ff2-b50c-84cb681fc2d4

	/// Weekends in slate on the weekday bars.
	measure 'Cal Weekday Colour' = IF(SELECTEDVALUE('Date'[Cal Weekday No]) >= 6, "#7C8598", "#111F38")
		lineageTag: 64f93b34-0ed7-554c-a431-ba758a253452

	measure 'Cal Month Label' = SELECTEDVALUE('Date'[Cal Month], "All months") & " " & SELECTEDVALUE('Date'[Cal Year], "all years")
		lineageTag: 814e1e97-2a05-582d-a97a-551e3bfba0e5

	/// The same days of the same month a year earlier.
	measure 'Cal Value Month PY' =
			VAR Y = SELECTEDVALUE('Date'[Cal Year])
			VAR Mn = SELECTEDVALUE('Date'[Cal Month No])
			VAR Cap = EDATE(MAX('Date'[Date]), -12)
			RETURN
			    IF(NOT ISBLANK(Y) && NOT ISBLANK(Mn), CALCULATE([Spend], REMOVEFILTERS('Date'), 'Date'[Cal Year] = Y - 1, 'Date'[Cal Month No] = Mn, 'Date'[Date] <= Cap))
		lineageTag: 21efc0a4-623a-5ff0-89b3-372e9a99baf9

	/// The year before, up to the same day of the year - so a part year is compared with
	/// the same part of the year before.
	measure 'Cal Value Year PY' =
			VAR Y = SELECTEDVALUE('Date'[Cal Year])
			VAR Cap = EDATE(MAX('Date'[Date]), -12)
			RETURN
			    IF(NOT ISBLANK(Y), CALCULATE([Spend], REMOVEFILTERS('Date'), 'Date'[Cal Year] = Y - 1, 'Date'[Date] <= Cap))
		lineageTag: 04840625-0915-59e8-9e64-218ab5b26df9

	/// False where the date table covers only part of the year on screen.
	measure 'Cal Year Is Whole' =
			VAR Y = SELECTEDVALUE('Date'[Cal Year])
			RETURN
			    CALCULATE(COUNTROWS('Date'), REMOVEFILTERS('Date'), 'Date'[Cal Year] = Y) >= 365
		lineageTag: 27816d6d-9892-5f25-a4f8-037101583527

	measure 'Card Cal Total Day' =
			VAR Cur = [Spend]
			VAR Prev = [Cal Value Month PY]
			VAR Change = DIVIDE(Cur - Prev, Prev)
			VAR NoteText =
			    IF(
			        Prev > 0,
			        "<tspan font-weight='700' fill='" & IF(Change >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(Change >= 0, "&#9650; ", "&#9660; ") & FORMAT(ABS(Change), "0.0%") & "</tspan>" & " on " & SELECTEDVALUE('Date'[Cal Month Short]) & " " & (SELECTEDVALUE('Date'[Cal Year]) - 1) & " (" & SWITCH(TRUE(), Prev >= 1000000, "$" & FORMAT(Prev / 1000000, "0.00") & "M", Prev >= 10000, "$" & FORMAT(Prev / 1000, "0.0") & "k", Prev >= 1000, "$" & FORMAT(Prev / 1000, "0.00") & "k", "$" & FORMAT(Prev, "0")) & ")",
			        "Nothing a year earlier to compare with"
			    )
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='476' height='152' viewBox='0 0 476 152' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='475' height='151' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='152' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "SPEND IN VIEW" & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & SWITCH(TRUE(), Cur >= 1000000, "$" & FORMAT(Cur / 1000000, "0.00") & "M", Cur >= 10000, "$" & FORMAT(Cur / 1000, "0.0") & "k", Cur >= 1000, "$" & FORMAT(Cur / 1000, "0.00") & "k", "$" & FORMAT(Cur, "0")) & "</text>"
			    & "<text x='16' y='77' font-size='11.5' fill='#667284'>" & NoteText & "</text>"
			    & "<line x1='16' y1='90' x2='460' y2='90' stroke='#E3E7EF'/>"
			    & "<text x='16' y='114' font-size='11.5' fill='#4A5768'>" & "Transactions" & "</text><text x='460' y='114' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & FORMAT([Approved Transactions], "#,0") & "</text>"
			    & "<text x='16' y='134' font-size='11.5' fill='#4A5768'>" & "Average per active day" & "</text><text x='460' y='134' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & SWITCH(TRUE(), [Cal Avg per Active Day] >= 1000000, "$" & FORMAT([Cal Avg per Active Day] / 1000000, "0.00") & "M", [Cal Avg per Active Day] >= 10000, "$" & FORMAT([Cal Avg per Active Day] / 1000, "0.0") & "k", [Cal Avg per Active Day] >= 1000, "$" & FORMAT([Cal Avg per Active Day] / 1000, "0.00") & "k", "$" & FORMAT([Cal Avg per Active Day], "0")) & "</text>"
			    & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: 8f0a4a30-2c15-5476-85f0-6712eba21e08

	measure 'Card Cal Total Month' =
			CALCULATE(
			VAR Cur = [Spend]
			VAR Prev = [Cal Value Year PY]
			VAR Change = DIVIDE(Cur - Prev, Prev)
			VAR NoteText =
			    IF(
			        Prev > 0,
			        "<tspan font-weight='700' fill='" & IF(Change >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(Change >= 0, "&#9650; ", "&#9660; ") & FORMAT(ABS(Change), "0.0%") & "</tspan>" & " on " & IF([Cal Year Is Whole], "", "the same period of ") & (SELECTEDVALUE('Date'[Cal Year]) - 1) & " (" & SWITCH(TRUE(), Prev >= 1000000, "$" & FORMAT(Prev / 1000000, "0.00") & "M", Prev >= 10000, "$" & FORMAT(Prev / 1000, "0.0") & "k", Prev >= 1000, "$" & FORMAT(Prev / 1000, "0.00") & "k", "$" & FORMAT(Prev, "0")) & ")",
			        "Nothing a year earlier to compare with"
			    )
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='476' height='152' viewBox='0 0 476 152' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='475' height='151' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='152' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "SPEND IN VIEW" & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & SWITCH(TRUE(), Cur >= 1000000, "$" & FORMAT(Cur / 1000000, "0.00") & "M", Cur >= 10000, "$" & FORMAT(Cur / 1000, "0.0") & "k", Cur >= 1000, "$" & FORMAT(Cur / 1000, "0.00") & "k", "$" & FORMAT(Cur, "0")) & "</text>"
			    & "<text x='16' y='77' font-size='11.5' fill='#667284'>" & NoteText & "</text>"
			    & "<line x1='16' y1='90' x2='460' y2='90' stroke='#E3E7EF'/>"
			    & "<text x='16' y='114' font-size='11.5' fill='#4A5768'>" & "Transactions" & "</text><text x='460' y='114' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & FORMAT([Approved Transactions], "#,0") & "</text>"
			    & "<text x='16' y='134' font-size='11.5' fill='#4A5768'>" & "Average per active day" & "</text><text x='460' y='134' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & SWITCH(TRUE(), [Cal Avg per Active Day] >= 1000000, "$" & FORMAT([Cal Avg per Active Day] / 1000000, "0.00") & "M", [Cal Avg per Active Day] >= 10000, "$" & FORMAT([Cal Avg per Active Day] / 1000, "0.0") & "k", [Cal Avg per Active Day] >= 1000, "$" & FORMAT([Cal Avg per Active Day] / 1000, "0.00") & "k", "$" & FORMAT([Cal Avg per Active Day], "0")) & "</text>"
			    & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"), REMOVEFILTERS('Date'[Cal Month]))
		dataCategory: ImageUrl
		lineageTag: 4cd1cba7-f1be-5e94-b14c-ece2b63fff89

	measure 'Card Cal Total All' =
			CALCULATE(
			VAR Cur = [Spend]
			VAR YearCount = COUNTROWS(FILTER(VALUES('Date'[Cal Year]), [Spend] > 0))
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='476' height='152' viewBox='0 0 476 152' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='475' height='151' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='152' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "SPEND IN VIEW" & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & SWITCH(TRUE(), Cur >= 1000000, "$" & FORMAT(Cur / 1000000, "0.00") & "M", Cur >= 10000, "$" & FORMAT(Cur / 1000, "0.0") & "k", Cur >= 1000, "$" & FORMAT(Cur / 1000, "0.00") & "k", "$" & FORMAT(Cur, "0")) & "</text>"
			    & "<text x='16' y='77' font-size='11.5' fill='#667284'>" & "All " & YearCount & " years - nothing earlier to compare with" & "</text>"
			    & "<line x1='16' y1='90' x2='460' y2='90' stroke='#E3E7EF'/>"
			    & "<text x='16' y='114' font-size='11.5' fill='#4A5768'>" & "Transactions" & "</text><text x='460' y='114' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & FORMAT([Approved Transactions], "#,0") & "</text>"
			    & "<text x='16' y='134' font-size='11.5' fill='#4A5768'>" & "Average per active day" & "</text><text x='460' y='134' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & SWITCH(TRUE(), [Cal Avg per Active Day] >= 1000000, "$" & FORMAT([Cal Avg per Active Day] / 1000000, "0.00") & "M", [Cal Avg per Active Day] >= 10000, "$" & FORMAT([Cal Avg per Active Day] / 1000, "0.0") & "k", [Cal Avg per Active Day] >= 1000, "$" & FORMAT([Cal Avg per Active Day] / 1000, "0.00") & "k", "$" & FORMAT([Cal Avg per Active Day], "0")) & "</text>"
			    & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"), REMOVEFILTERS('Date'[Cal Month], 'Date'[Cal Year]))
		dataCategory: ImageUrl
		lineageTag: 96430796-c8f2-5b88-908c-167f00ba1a2e

	measure 'Card Cal Peak Day' =
			VAR Pool = ADDCOLUMNS(VALUES('Date'[Date]), "@v", [Spend])
			VAR Best = MAXX(Pool, [@v])
			VAR BestDate = MINX(FILTER(Pool, [@v] = Best), 'Date'[Date])
			VAR DaysAll = COUNTROWS(Pool)
			VAR Quiet = DaysAll - [Cal Active Days]
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='476' height='152' viewBox='0 0 476 152' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='475' height='151' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='152' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "BIGGEST DAY" & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & SWITCH(TRUE(), Best >= 1000000, "$" & FORMAT(Best / 1000000, "0.00") & "M", Best >= 10000, "$" & FORMAT(Best / 1000, "0.0") & "k", Best >= 1000, "$" & FORMAT(Best / 1000, "0.00") & "k", "$" & FORMAT(Best, "0")) & "</text>"
			    & "<text x='16' y='77' font-size='11.5' fill='#667284'>" & FORMAT(BestDate, "ddd d mmmm yyyy") & "</text>"
			    & "<line x1='16' y1='90' x2='460' y2='90' stroke='#E3E7EF'/>"
			    & "<text x='16' y='111' font-size='11.5' fill='#4A5768'>" & "Average per active day" & "</text><text x='460' y='111' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & SWITCH(TRUE(), [Cal Avg per Active Day] >= 1000000, "$" & FORMAT([Cal Avg per Active Day] / 1000000, "0.00") & "M", [Cal Avg per Active Day] >= 10000, "$" & FORMAT([Cal Avg per Active Day] / 1000, "0.0") & "k", [Cal Avg per Active Day] >= 1000, "$" & FORMAT([Cal Avg per Active Day] / 1000, "0.00") & "k", "$" & FORMAT([Cal Avg per Active Day], "0")) & "</text>"
			    & "<text x='16' y='128' font-size='11.5' fill='#4A5768'>" & "Days with no spend" & "</text><text x='460' y='128' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & Quiet & " of " & DaysAll & "</text>"
			    & "<text x='16' y='145' font-size='11.5' fill='#4A5768'>" & "Biggest day&apos;s share of the month" & "</text><text x='460' y='145' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & FORMAT(DIVIDE(Best, [Spend]), "0.0%") & "</text>"
			    & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: e937bdde-6bd9-5489-ae39-de9375b772f6

	measure 'Card Cal Peak Month' =
			CALCULATE(
			VAR Pool = FILTER(ADDCOLUMNS(SUMMARIZE('Date', 'Date'[Cal Month No], 'Date'[Cal Month], 'Date'[Cal Month Short]), "@v", [Spend]), [@v] > 0)
			VAR Best = MAXX(Pool, [@v])
			VAR Worst = MINX(Pool, [@v])
			VAR BestName = MINX(FILTER(Pool, [@v] = Best), 'Date'[Cal Month])
			VAR WorstName = MINX(FILTER(Pool, [@v] = Worst), 'Date'[Cal Month Short])
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='476' height='152' viewBox='0 0 476 152' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='475' height='151' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='152' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "BIGGEST MONTH" & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & SWITCH(TRUE(), Best >= 1000000, "$" & FORMAT(Best / 1000000, "0.00") & "M", Best >= 10000, "$" & FORMAT(Best / 1000, "0.0") & "k", Best >= 1000, "$" & FORMAT(Best / 1000, "0.00") & "k", "$" & FORMAT(Best, "0")) & "</text>"
			    & "<text x='16' y='77' font-size='11.5' fill='#667284'>" & BestName & " " & SELECTEDVALUE('Date'[Cal Year]) & "</text>"
			    & "<line x1='16' y1='90' x2='460' y2='90' stroke='#E3E7EF'/>"
			    & "<text x='16' y='111' font-size='11.5' fill='#4A5768'>" & "Average per month" & "</text><text x='460' y='111' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & SWITCH(TRUE(), DIVIDE([Spend], COUNTROWS(Pool)) >= 1000000, "$" & FORMAT(DIVIDE([Spend], COUNTROWS(Pool)) / 1000000, "0.00") & "M", DIVIDE([Spend], COUNTROWS(Pool)) >= 10000, "$" & FORMAT(DIVIDE([Spend], COUNTROWS(Pool)) / 1000, "0.0") & "k", DIVIDE([Spend], COUNTROWS(Pool)) >= 1000, "$" & FORMAT(DIVIDE([Spend], COUNTROWS(Pool)) / 1000, "0.00") & "k", "$" & FORMAT(DIVIDE([Spend], COUNTROWS(Pool)), "0")) & "</text>"
			    & "<text x='16' y='128' font-size='11.5' fill='#4A5768'>" & "Smallest month" & "</text><text x='460' y='128' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & WorstName & " &#183; " & SWITCH(TRUE(), Worst >= 1000000, "$" & FORMAT(Worst / 1000000, "0.00") & "M", Worst >= 10000, "$" & FORMAT(Worst / 1000, "0.0") & "k", Worst >= 1000, "$" & FORMAT(Worst / 1000, "0.00") & "k", "$" & FORMAT(Worst, "0")) & "</text>"
			    & "<text x='16' y='145' font-size='11.5' fill='#4A5768'>" & "Biggest month&apos;s share of the year" & IF([Cal Year Is Whole], "", " to date") & "</text><text x='460' y='145' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & FORMAT(DIVIDE(Best, [Spend]), "0.0%") & "</text>"
			    & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"), REMOVEFILTERS('Date'[Cal Month]))
		dataCategory: ImageUrl
		lineageTag: 1f03edeb-787e-5b6a-9f7d-dde2888ba161

	measure 'Card Cal Peak Quarter' =
			CALCULATE(
			VAR Pool = FILTER(ADDCOLUMNS(SUMMARIZE('Date', 'Date'[Cal Quarter Key], 'Date'[Cal Quarter Label]), "@v", [Spend]), [@v] > 0)
			VAR Best = MAXX(Pool, [@v])
			VAR BestName = MINX(FILTER(Pool, [@v] = Best), 'Date'[Cal Quarter Label])
			VAR AllValue = [Spend]
			VAR WholeYears = FILTER(VALUES('Date'[Cal Year]), VAR Yr = 'Date'[Cal Year] RETURN CALCULATE(COUNTROWS('Date'), REMOVEFILTERS('Date'), 'Date'[Cal Year] = Yr) >= 365)
			VAR PartYears = COUNTROWS(FILTER(VALUES('Date'[Cal Year]), [Spend] > 0)) - COUNTROWS(FILTER(WholeYears, [Spend] > 0))
			VAR WholeValue = CALCULATE([Spend], WholeYears)
			VAR ShareNote = IF(PartYears > 0, " share, whole years", " share of the total")
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='476' height='152' viewBox='0 0 476 152' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='475' height='151' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='152' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "BIGGEST QUARTER" & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & SWITCH(TRUE(), Best >= 1000000, "$" & FORMAT(Best / 1000000, "0.00") & "M", Best >= 10000, "$" & FORMAT(Best / 1000, "0.0") & "k", Best >= 1000, "$" & FORMAT(Best / 1000, "0.00") & "k", "$" & FORMAT(Best, "0")) & "</text>"
			    & "<text x='16' y='77' font-size='11.5' fill='#667284'>" & BestName & "</text>"
			    & "<line x1='16' y1='90' x2='460' y2='90' stroke='#E3E7EF'/>"
			    & "<text x='16' y='111' font-size='11.5' fill='#4A5768'>" & "Average per quarter" & "</text><text x='460' y='111' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & SWITCH(TRUE(), DIVIDE(AllValue, COUNTROWS(Pool)) >= 1000000, "$" & FORMAT(DIVIDE(AllValue, COUNTROWS(Pool)) / 1000000, "0.00") & "M", DIVIDE(AllValue, COUNTROWS(Pool)) >= 10000, "$" & FORMAT(DIVIDE(AllValue, COUNTROWS(Pool)) / 1000, "0.0") & "k", DIVIDE(AllValue, COUNTROWS(Pool)) >= 1000, "$" & FORMAT(DIVIDE(AllValue, COUNTROWS(Pool)) / 1000, "0.00") & "k", "$" & FORMAT(DIVIDE(AllValue, COUNTROWS(Pool)), "0")) & "</text>"
			    & "<text x='16' y='128' font-size='11.5' fill='#4A5768'>" & "Q4" & ShareNote & "</text><text x='460' y='128' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & FORMAT(DIVIDE(CALCULATE([Spend], 'Date'[Cal Quarter] = "Q4", WholeYears), WholeValue), "0.0%") & "</text>"
			    & "<text x='16' y='145' font-size='11.5' fill='#4A5768'>" & "Q1" & ShareNote & "</text><text x='460' y='145' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & FORMAT(DIVIDE(CALCULATE([Spend], 'Date'[Cal Quarter] = "Q1", WholeYears), WholeValue), "0.0%") & "</text>"
			    & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"), REMOVEFILTERS('Date'[Cal Month], 'Date'[Cal Year]))
		dataCategory: ImageUrl
		lineageTag: ad96807a-d920-507f-bd19-31850d6a3a30

	measure 'Card Cal Peak Year' =
			CALCULATE(
			VAR AllYears = FILTER(ADDCOLUMNS(VALUES('Date'[Cal Year]), "@v", [Spend]), [@v] > 0)
			VAR Pool = FILTER(AllYears, VAR Yr = 'Date'[Cal Year] RETURN CALCULATE(COUNTROWS('Date'), REMOVEFILTERS('Date'), 'Date'[Cal Year] = Yr) >= 365)
			VAR PartYears = COUNTROWS(AllYears) - COUNTROWS(Pool)
			VAR YearLast = MAXX(Pool, 'Date'[Cal Year])
			VAR YearFirst = MINX(Pool, 'Date'[Cal Year])
			VAR ValueLast = MAXX(FILTER(Pool, 'Date'[Cal Year] = YearLast), [@v])
			VAR ValueBefore = MAXX(FILTER(Pool, 'Date'[Cal Year] = YearLast - 1), [@v])
			VAR ValueFirst = MAXX(FILTER(Pool, 'Date'[Cal Year] = YearFirst), [@v])
			VAR ValueSecond = MAXX(FILTER(Pool, 'Date'[Cal Year] = YearFirst + 1), [@v])
			VAR Best = MAXX(Pool, [@v])
			VAR BestYear = MINX(FILTER(Pool, [@v] = Best), 'Date'[Cal Year])
			VAR ChangeLast = DIVIDE(ValueLast - ValueBefore, ValueBefore)
			VAR ChangeSecond = DIVIDE(ValueSecond - ValueFirst, ValueFirst)
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='476' height='152' viewBox='0 0 476 152' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='475' height='151' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='152' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "BIGGEST YEAR" & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & SWITCH(TRUE(), Best >= 1000000, "$" & FORMAT(Best / 1000000, "0.00") & "M", Best >= 10000, "$" & FORMAT(Best / 1000, "0.0") & "k", Best >= 1000, "$" & FORMAT(Best / 1000, "0.00") & "k", "$" & FORMAT(Best, "0")) & "</text>"
			    & "<text x='16' y='77' font-size='11.5' fill='#667284'>" & FORMAT(BestYear, "0") & "</text>"
			    & "<line x1='16' y1='90' x2='460' y2='90' stroke='#E3E7EF'/>"
			    & "<text x='16' y='111' font-size='11.5' fill='#4A5768'>" & IF(PartYears > 0, "Average per whole year", "Average per year") & "</text><text x='460' y='111' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & SWITCH(TRUE(), AVERAGEX(Pool, [@v]) >= 1000000, "$" & FORMAT(AVERAGEX(Pool, [@v]) / 1000000, "0.00") & "M", AVERAGEX(Pool, [@v]) >= 10000, "$" & FORMAT(AVERAGEX(Pool, [@v]) / 1000, "0.0") & "k", AVERAGEX(Pool, [@v]) >= 1000, "$" & FORMAT(AVERAGEX(Pool, [@v]) / 1000, "0.00") & "k", "$" & FORMAT(AVERAGEX(Pool, [@v]), "0")) & "</text>"
			    & "<text x='16' y='128' font-size='11.5' fill='#4A5768'>" & YearLast & " on " & (YearLast - 1) & "</text><text x='460' y='128' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & "<tspan font-weight='700' fill='" & IF(ChangeLast >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(ChangeLast >= 0, "&#9650; ", "&#9660; ") & FORMAT(ABS(ChangeLast), "0.0%") & "</tspan>" & "</text>"
			    & "<text x='16' y='145' font-size='11.5' fill='#4A5768'>" & (YearFirst + 1) & " on " & YearFirst & "</text><text x='460' y='145' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & "<tspan font-weight='700' fill='" & IF(ChangeSecond >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(ChangeSecond >= 0, "&#9650; ", "&#9660; ") & FORMAT(ABS(ChangeSecond), "0.0%") & "</tspan>" & "</text>"
			    & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"), REMOVEFILTERS('Date'[Cal Month], 'Date'[Cal Year]))
		dataCategory: ImageUrl
		lineageTag: 329509e4-1d27-5f0d-8ac3-fce6ed50936e

	measure 'Title Cal Day' =
			VAR Cur = [Spend]
			RETURN
			    [Cal Month Label] & ": " & SWITCH(TRUE(), Cur >= 1000000, "$" & FORMAT(Cur / 1000000, "0.00") & "M", Cur >= 10000, "$" & FORMAT(Cur / 1000, "0.0") & "k", Cur >= 1000, "$" & FORMAT(Cur / 1000, "0.00") & "k", "$" & FORMAT(Cur, "0")) & " in spend" & " across " & [Cal Active Days] & " active days" 
		lineageTag: d184ad61-8464-5569-92df-f074d25e58c1

	measure 'Title Cal Month' =
			CALCULATE(
			VAR Pool = ADDCOLUMNS(SUMMARIZE('Date', 'Date'[Cal Month No], 'Date'[Cal Month]), "@v", [Spend])
			VAR Best = MAXX(Pool, [@v])
			VAR Cur = [Spend]
			RETURN
			    SELECTEDVALUE('Date'[Cal Year]) & ": " & SWITCH(TRUE(), Cur >= 1000000, "$" & FORMAT(Cur / 1000000, "0.00") & "M", Cur >= 10000, "$" & FORMAT(Cur / 1000, "0.0") & "k", Cur >= 1000, "$" & FORMAT(Cur / 1000, "0.00") & "k", "$" & FORMAT(Cur, "0")) & " in spend" & ", and " & MINX(FILTER(Pool, [@v] = Best), 'Date'[Cal Month]) & " was the biggest month" , REMOVEFILTERS('Date'[Cal Month]))
		lineageTag: 9594c958-b235-5d2f-a461-c0c62f65ea00

	measure 'Title Cal Quarter' =
			CALCULATE(
			VAR WholeYears = FILTER(VALUES('Date'[Cal Year]), VAR Yr = 'Date'[Cal Year] RETURN CALCULATE(COUNTROWS('Date'), REMOVEFILTERS('Date'), 'Date'[Cal Year] = Yr) >= 365)
			VAR PartYears = COUNTROWS(FILTER(VALUES('Date'[Cal Year]), [Spend] > 0)) - COUNTROWS(FILTER(WholeYears, [Spend] > 0))
			VAR WholeValue = CALCULATE([Spend], WholeYears)
			VAR Pool = ADDCOLUMNS(VALUES('Date'[Cal Quarter]), "@v", CALCULATE([Spend], WholeYears))
			VAR Best = MAXX(Pool, [@v])
			RETURN
			    MINX(FILTER(Pool, [@v] = Best), 'Date'[Cal Quarter]) & " carries " & FORMAT(DIVIDE(Best, WholeValue), "0%") & " of all spend, more than any other quarter"
			        & IF(PartYears > 0, " (whole years only)", "") , REMOVEFILTERS('Date'[Cal Month], 'Date'[Cal Year]))
		lineageTag: 1f075cbe-506a-5282-a48e-96e0d00f5095

	measure 'Title Cal Year' =
			CALCULATE(
			VAR AllYears = FILTER(ADDCOLUMNS(VALUES('Date'[Cal Year]), "@v", [Spend]), [@v] > 0)
			VAR Pool = FILTER(AllYears, VAR Yr = 'Date'[Cal Year] RETURN CALCULATE(COUNTROWS('Date'), REMOVEFILTERS('Date'), 'Date'[Cal Year] = Yr) >= 365)
			VAR PartYears = COUNTROWS(AllYears) - COUNTROWS(Pool)
			VAR YearLast = MAXX(Pool, 'Date'[Cal Year])
			VAR YearFirst = MINX(Pool, 'Date'[Cal Year])
			VAR ValueLast = MAXX(FILTER(Pool, 'Date'[Cal Year] = YearLast), [@v])
			VAR ValueBefore = MAXX(FILTER(Pool, 'Date'[Cal Year] = YearLast - 1), [@v])
			VAR ValueFirst = MAXX(FILTER(Pool, 'Date'[Cal Year] = YearFirst), [@v])
			VAR ValueSecond = MAXX(FILTER(Pool, 'Date'[Cal Year] = YearFirst + 1), [@v])
			VAR Change = DIVIDE(ValueLast - ValueFirst, ValueFirst)
			RETURN
			    YearLast & " closed at " & SWITCH(TRUE(), ValueLast >= 1000000, "$" & FORMAT(ValueLast / 1000000, "0.00") & "M", ValueLast >= 10000, "$" & FORMAT(ValueLast / 1000, "0.0") & "k", ValueLast >= 1000, "$" & FORMAT(ValueLast / 1000, "0.00") & "k", "$" & FORMAT(ValueLast, "0")) & " in spend" & ", " & IF(Change >= 0, "up ", "down ") & FORMAT(ABS(Change), "0.0%") & " on " & YearFirst
			        & IF(PartYears > 0, " (whole years only)", "") , REMOVEFILTERS('Date'[Cal Month], 'Date'[Cal Year]))
		lineageTag: 540d361e-2781-5e9a-855f-9f382a7967f6

	measure 'Title Cal Weekday' =
			VAR Pool = FILTER(ADDCOLUMNS(SUMMARIZE('Date', 'Date'[Cal Weekday No], 'Date'[Cal Day Name]), "@v", [Cal Avg per Active Day]), [@v] > 0)
			VAR Best = MAXX(Pool, [@v])
			RETURN
			    IF(ISEMPTY(Pool), "Nothing in this period", MINX(FILTER(Pool, [@v] = Best), 'Date'[Cal Day Name]) & "s run highest per active day")
		lineageTag: 095bd0d3-a542-5f44-87ae-9cde2b3f9ba7

	measure 'Standfirst Cal Day' =
			VAR Cur = [Spend]
			VAR Prev = [Cal Value Month PY]
			VAR Change = DIVIDE(Cur - Prev, Prev)
			VAR Pool = ADDCOLUMNS(VALUES('Date'[Date]), "@v", [Spend])
			VAR Best = MAXX(Pool, [@v])
			VAR BestDay = DAY(MINX(FILTER(Pool, [@v] = Best), 'Date'[Date]))
			VAR Sfx = SWITCH(TRUE(), MOD(BestDay, 100) IN {11, 12, 13}, "th", MOD(BestDay, 10) = 1, "st", MOD(BestDay, 10) = 2, "nd", MOD(BestDay, 10) = 3, "rd", "th")
			VAR DaysAll = COUNTROWS(Pool)
			RETURN
			    [Cal Month Label] & " recorded " & SWITCH(TRUE(), Cur >= 1000000, "$" & FORMAT(Cur / 1000000, "0.00") & "M", Cur >= 10000, "$" & FORMAT(Cur / 1000, "0.0") & "k", Cur >= 1000, "$" & FORMAT(Cur / 1000, "0.00") & "k", "$" & FORMAT(Cur, "0")) & " in spend" & " from " & FORMAT([Approved Transactions], "#,0") & " transactions"
			        & IF(Prev > 0, ", " & IF(Change >= 0, "up ", "down ") & FORMAT(ABS(Change), "0.0%") & " on the same month a year earlier", "")
			        & ". The biggest day was the " & BestDay & Sfx & " at " & SWITCH(TRUE(), Best >= 1000000, "$" & FORMAT(Best / 1000000, "0.00") & "M", Best >= 10000, "$" & FORMAT(Best / 1000, "0.0") & "k", Best >= 1000, "$" & FORMAT(Best / 1000, "0.00") & "k", "$" & FORMAT(Best, "0")) & "; "
			        & IF(DaysAll = [Cal Active Days], "none of the " & DaysAll, (DaysAll - [Cal Active Days]) & " of " & DaysAll)
			        & " days had no spend." 
		lineageTag: 47ce3b91-95bd-54f6-a72a-ce8aabd5aafb

	measure 'Standfirst Cal Month' =
			CALCULATE(
			VAR Cur = [Spend]
			VAR Prev = [Cal Value Year PY]
			VAR Change = DIVIDE(Cur - Prev, Prev)
			VAR Pool = ADDCOLUMNS(SUMMARIZE('Date', 'Date'[Cal Month No], 'Date'[Cal Month]), "@v", [Spend])
			VAR Best = MAXX(Pool, [@v])
			RETURN
			    SELECTEDVALUE('Date'[Cal Year]) & " recorded " & SWITCH(TRUE(), Cur >= 1000000, "$" & FORMAT(Cur / 1000000, "0.00") & "M", Cur >= 10000, "$" & FORMAT(Cur / 1000, "0.0") & "k", Cur >= 1000, "$" & FORMAT(Cur / 1000, "0.00") & "k", "$" & FORMAT(Cur, "0")) & " in spend" & " from " & FORMAT([Approved Transactions], "#,0") & " transactions"
			        & IF(Prev > 0, ", " & IF(Change >= 0, "up ", "down ") & FORMAT(ABS(Change), "0.0%") & " on " & IF([Cal Year Is Whole], "", "the same period of ") & (SELECTEDVALUE('Date'[Cal Year]) - 1), "")
			        & ". " & MINX(FILTER(Pool, [@v] = Best), 'Date'[Cal Month]) & " alone was " & FORMAT(DIVIDE(Best, Cur), "0.0%")
			        & " of the year" & IF([Cal Year Is Whole], "", " to date") & ". Switch to Day to open a month." , REMOVEFILTERS('Date'[Cal Month]))
		lineageTag: 71f31e4c-f555-574b-a52d-d7845f6c5e4f

	measure 'Standfirst Cal Quarter' =
			CALCULATE(
			VAR Cur = [Spend]
			VAR Pool = FILTER(ADDCOLUMNS(VALUES('Date'[Cal Year]), "@v", [Spend]), [@v] > 0)
			RETURN
			    MINX(Pool, 'Date'[Cal Year]) & " to " & MAXX(Pool, 'Date'[Cal Year]) & " recorded " & SWITCH(TRUE(), Cur >= 1000000, "$" & FORMAT(Cur / 1000000, "0.00") & "M", Cur >= 10000, "$" & FORMAT(Cur / 1000, "0.0") & "k", Cur >= 1000, "$" & FORMAT(Cur / 1000, "0.00") & "k", "$" & FORMAT(Cur, "0")) & " in spend" & " from " & FORMAT([Approved Transactions], "#,0") & " transactions"
			        & ". Read across a row for the shape of a year, down a column for the same quarter year on year." , REMOVEFILTERS('Date'[Cal Month], 'Date'[Cal Year]))
		lineageTag: 7e6148a1-5ae8-57f0-b94a-90a9ba23a768

	measure 'Standfirst Cal Year' =
			CALCULATE(
			VAR Cur = [Spend]
			VAR YearCount = COUNTROWS(FILTER(ADDCOLUMNS(VALUES('Date'[Cal Year]), "@v", [Spend]), [@v] > 0))
			RETURN
			    YearCount & " years, " & SWITCH(TRUE(), Cur >= 1000000, "$" & FORMAT(Cur / 1000000, "0.00") & "M", Cur >= 10000, "$" & FORMAT(Cur / 1000, "0.0") & "k", Cur >= 1000, "$" & FORMAT(Cur / 1000, "0.00") & "k", "$" & FORMAT(Cur, "0")) & " in spend" & " from " & FORMAT([Approved Transactions], "#,0") & " transactions"
			        & ". Switch to Quarter or Month to see where inside a year the change came from." , REMOVEFILTERS('Date'[Cal Month], 'Date'[Cal Year]))
		lineageTag: 8d9e03e7-71b9-58e6-9127-7d70871af56a

	/// The five-band key under the calendar.
	measure 'Cal Legend' =
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='640' height='20' viewBox='0 0 640 20' font-family='Segoe UI, sans-serif'>"
			        & "<text x='0' y='14' font-size='11' fill='#667284'>Lower</text><rect x='46' y='5' width='26' height='10' rx='1' fill='#E6E9F1'/><rect x='78' y='5' width='26' height='10' rx='1' fill='#BCC1D2'/><rect x='110' y='5' width='26' height='10' rx='1' fill='#7C8598'/><rect x='142' y='5' width='26' height='10' rx='1' fill='#3E4A66'/><rect x='174' y='5' width='26' height='10' rx='1' fill='#111F38'/>"
			        & "<text x='208' y='14' font-size='11' fill='#667284'>Higher</text>"
			        & "<text x='262' y='14' font-size='11' fill='#667284'>Shade = fifths of the cells shown &#183; &#8211; no spend</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: cf5bc171-42e4-5d9d-8e5f-50b487d7dfd5

	column Placeholder
		dataType: string
		isHidden
		lineageTag: f63c43a6-5f04-52dd-8c52-b119eeb0c52d
		summarizeBy: none
		sourceColumn: [Placeholder]

	partition 'Calendar Metrics' = calculated
		mode: import
		source = ROW("Placeholder", "")
