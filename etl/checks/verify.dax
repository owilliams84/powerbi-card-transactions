EVALUATE
UNION(
    SELECTCOLUMNS(
        SUMMARIZECOLUMNS(
            'Date'[Year],
            "v_transactions", [Transactions],
            "v_approved", [Approved Transactions],
            "v_spend", [Spend],
            "v_decline_rate", [Decline Rate %],
            "v_labelled", [Labelled Transactions],
            "v_fraud", [Fraud Transactions],
            "v_fraud_10k", [Fraud Rate per 10k],
            "v_fraud_10k_naive", [Fraud Rate per 10k (all rows)],
            "v_cards", [Active Cards],
            "v_clients", [Active Clients]
        ),
        "grain", "year",
        "key", FORMAT('Date'[Year], "0"),
        "transactions", [v_transactions],
        "approved", [v_approved],
        "spend", ROUND([v_spend], 2),
        "decline_rate", ROUND([v_decline_rate], 6),
        "labelled", [v_labelled],
        "fraud", [v_fraud],
        "fraud_10k", ROUND([v_fraud_10k], 4),
        "fraud_10k_naive", ROUND([v_fraud_10k_naive], 4),
        "cards", [v_cards],
        "clients", [v_clients]
    ),
    SELECTCOLUMNS(
        SUMMARIZECOLUMNS(
            'Channel'[Channel],
            "v_transactions", [Transactions],
            "v_approved", [Approved Transactions],
            "v_spend", [Spend],
            "v_decline_rate", [Decline Rate %],
            "v_labelled", [Labelled Transactions],
            "v_fraud", [Fraud Transactions],
            "v_fraud_10k", [Fraud Rate per 10k],
            "v_fraud_10k_naive", [Fraud Rate per 10k (all rows)],
            "v_cards", [Active Cards],
            "v_clients", [Active Clients]
        ),
        "grain", "channel",
        "key", 'Channel'[Channel],
        "transactions", [v_transactions],
        "approved", [v_approved],
        "spend", ROUND([v_spend], 2),
        "decline_rate", ROUND([v_decline_rate], 6),
        "labelled", [v_labelled],
        "fraud", [v_fraud],
        "fraud_10k", ROUND([v_fraud_10k], 4),
        "fraud_10k_naive", ROUND([v_fraud_10k_naive], 4),
        "cards", [v_cards],
        "clients", [v_clients]
    ),
    SELECTCOLUMNS(
        SUMMARIZECOLUMNS(
            'Merchant Category'[Category Group],
            "v_transactions", [Transactions],
            "v_approved", [Approved Transactions],
            "v_spend", [Spend],
            "v_decline_rate", [Decline Rate %],
            "v_labelled", [Labelled Transactions],
            "v_fraud", [Fraud Transactions],
            "v_fraud_10k", [Fraud Rate per 10k],
            "v_fraud_10k_naive", [Fraud Rate per 10k (all rows)],
            "v_cards", [Active Cards],
            "v_clients", [Active Clients]
        ),
        "grain", "category",
        "key", 'Merchant Category'[Category Group],
        "transactions", [v_transactions],
        "approved", [v_approved],
        "spend", ROUND([v_spend], 2),
        "decline_rate", ROUND([v_decline_rate], 6),
        "labelled", [v_labelled],
        "fraud", [v_fraud],
        "fraud_10k", ROUND([v_fraud_10k], 4),
        "fraud_10k_naive", ROUND([v_fraud_10k_naive], 4),
        "cards", [v_cards],
        "clients", [v_clients]
    ),
    SELECTCOLUMNS(
        SUMMARIZECOLUMNS(
            'Geography'[Location Type],
            "v_transactions", [Transactions],
            "v_approved", [Approved Transactions],
            "v_spend", [Spend],
            "v_decline_rate", [Decline Rate %],
            "v_labelled", [Labelled Transactions],
            "v_fraud", [Fraud Transactions],
            "v_fraud_10k", [Fraud Rate per 10k],
            "v_fraud_10k_naive", [Fraud Rate per 10k (all rows)],
            "v_cards", [Active Cards],
            "v_clients", [Active Clients]
        ),
        "grain", "loctype",
        "key", 'Geography'[Location Type],
        "transactions", [v_transactions],
        "approved", [v_approved],
        "spend", ROUND([v_spend], 2),
        "decline_rate", ROUND([v_decline_rate], 6),
        "labelled", [v_labelled],
        "fraud", [v_fraud],
        "fraud_10k", ROUND([v_fraud_10k], 4),
        "fraud_10k_naive", ROUND([v_fraud_10k_naive], 4),
        "cards", [v_cards],
        "clients", [v_clients]
    )
)
